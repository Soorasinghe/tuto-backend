# ── Local development ──
PORT=5001
# Path to the Firebase service-account JSON (never commit that file)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ── Vercel (Project → Settings → Environment Variables) ──
# Base64 of the service-account JSON:  base64 -i firebase-service-account.json | pbcopy
GOOGLE_APPLICATION_CREDENTIALS_BASE64=
# Long random string. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Without it the daily downgrade job refuses every request.
CRON_SECRET=
# Random string used to hash IPs for rate limiting
RATE_LIMIT_SALT=

# Optional (defaults to tuto-lk.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=
