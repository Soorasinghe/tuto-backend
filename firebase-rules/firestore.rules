rules_version = '2';

// Tuto.lk — Firestore rules
// All database access goes through the Express backend (Firebase Admin SDK),
// which bypasses these rules. The website never talks to Firestore directly,
// so browsers get NO access at all. This stops anyone using the public
// web API key from reading teachers' phone numbers, leads, or payments.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
